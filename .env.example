# Puerto del servidor (Hugging Face usa 7860 por defecto)
PORT=7860
NODE_ENV=development

# Credenciales oficiales de Mercado Pago Developers
# Obtén tu Access Token en: https://www.mercadopago.com.ar/developers/panel/app
# Deja vacío o comenta para usar el Modo Simulador local
MP_ACCESS_TOKEN=

# URL pública de tu aplicación (ejemplo: https://mi-usuario-mi-espacio.hf.space o https://xxx.ngrok-free.app)
BASE_URL=

# Clave secreta para firmar tokens criptográficos de la bóveda (Generada automáticamente si se omite)
VAULT_SECRET_KEY=clave_secreta_super_segura_para_firmas_hmac_sha256

# Precio del producto en ARS
ITEM_PRICE=10.00
